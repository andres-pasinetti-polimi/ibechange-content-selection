FROM python:3.13.1

WORKDIR /app
ENV PYTHONPATH=/app

# deps first
COPY time_service/requirements.txt /tmp/requirements_time_service.txt
RUN pip install --no-cache-dir -r /tmp/requirements_time_service.txt

# then code
COPY time_service /app/time_service

CMD ["python", "-u", "-m", "time_service.time_service"]